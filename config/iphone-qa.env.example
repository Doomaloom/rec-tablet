# Copy this file to config/iphone-qa.env to override the iPhone QA defaults.
# The copied file is ignored by Git.

QA_WIDTH=800
QA_HEIGHT=480
QA_DISPLAY=90
QA_VNC_PORT=5990
QA_WEB_PORT=6080
QA_FYNE_SCALE=1

# Leave blank to bind noVNC to the IPv4 address used by the default route.
# Set QA_PUBLIC_HOST when the address Safari should use differs from the bind address.
QA_LISTEN_HOST=
QA_PUBLIC_HOST=

# Fullscreen is opt-in. The normal QA window already requests 800 x 480.
QA_FULLSCREEN=0

# Rebuild the native app whenever the QA session starts.
QA_BUILD=1

# Force Mesa software rendering inside Xvnc. This is the reliable default for
# a virtual X server and does not affect normal desktop launches.
QA_SOFTWARE_RENDERING=1

# Current noVNC requires a secure browser context. The launcher generates a
# self-signed LAN certificate in .qa/credentials and serves HTTPS by default.
QA_TLS=1
